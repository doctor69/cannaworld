                    {s.medical.map(m => <span class="tag tag-medical">{m}</span>)}
                  </div>
                </div>
                <p class="card-desc full-desc">{s.description}</p>
              </div>
            </div>
          </article>
        );
      })}
    </section>

    <!-- ── World Origins Section ───────────────────────────────────── -->
    <section class="container origins-section">
      <h2 class="section-title">🌍 World Origins</h2>
      <p class="section-subtitle">Cannabis has been cultivated across the globe for thousands of years. Here's where our featured strains come from:</p>
      <div class="origins-grid">
        {regionOrder.map(region => {
          const regionStrains = regionMap[region] ?? [];
          return (
            <div class="origin-card">
              <h3 class="origin-region">{region}</h3>
              <div class="origin-strains">
                {regionStrains.map(s => (
                  <div class={`origin-strain origin-strain--${s.type}`}>
