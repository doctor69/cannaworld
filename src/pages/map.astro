<style>
  /* ---- Page wrapper ---- */
  .map-page {
    padding-bottom: 4rem;
  }

  /* ---- Header ---- */
  .map-page-header {
    text-align: center;
    padding: 3rem 0 2rem;
    background: linear-gradient(180deg, rgba(13,22,16,0.9) 0%, transparent 100%);
  }
  .map-page-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.6rem;
    letter-spacing: -0.5px;
  }
  .map-page-subtitle {
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 640px;
    margin: 0 auto 1.5rem;
    line-height: 1.7;
  }

  /* ---- Stats Bar ---- */
  .map-stats-bar {
    display: inline-flex;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 50px;
    padding: 0.5rem 1.5rem;
    margin-bottom: 1.4rem;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
  }
  .map-stat-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.9rem;
  }
  .map-stat-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .map-stat-count {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }
  .map-stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .map-stat-div {
    width: 1px;
    height: 24px;
    background: var(--border);
  }

  /* ---- Legend ---- */
  .map-legend {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .map-legend-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.87rem;
    color: var(--text);
  }
  .map-legend-swatch {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .map-legend-item small {
    color: var(--text-muted);
  }

  /* ---- Map wrapper ---- */
  .map-wrapper {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.25rem;
    overflow: hidden;
  }
  #us-map {
    width: 100%;
    height: auto;
    display: block;
  }
  #us-map path, #us-map circle {
    stroke: rgba(10,15,13,0.7);
    stroke-width: 0.8;
    cursor: pointer;
    transition: filter 0.15s ease, stroke-width 0.15s ease, stroke 0.15s ease;
  }
  /* Status fill colors */
  #us-map .status-fully-legal    { fill: #4ade80; }
  #us-map .status-medical        { fill: #fbbf24; }
  #us-map .status-decriminalized { fill: #60a5fa; }
  #us-map .status-illegal        { fill: #f87171; }
  /* Hover state */
  #us-map path:hover, #us-map circle:hover {
    filter: brightness(1.3) drop-shadow(0 0 5px rgba(255,255,255,0.25));
    stroke-width: 1.5;
    stroke: rgba(255,255,255,0.8);
  }
  /* Active/clicked state */
  #us-map path.map-active, #us-map circle.map-active {
    filter: brightness(1.45) drop-shadow(0 0 8px rgba(255,255,255,0.4));
    stroke: #ffffff;
    stroke-width: 2;
  }

  /* ---- Tooltip ---- */
  .map-tooltip {
    position: fixed;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 8px;
    padding: 0.4rem 0.8rem;
    pointer-events: none;
    z-index: 250;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text);
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  /* ---- Status Badges (map-specific, don't conflict with global .badge) ---- */
  .map-status-badge {
    display: inline-block;
    padding: 0.18rem 0.6rem;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .map-status-badge-lg {
    padding: 0.28rem 0.85rem;
    font-size: 0.76rem;
  }
  .map-status-badge.status-fully-legal    { background: rgba(74,222,128,0.15); color: #4ade80; border: 1px solid rgba(74,222,128,0.4); }
