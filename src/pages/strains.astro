                      <span class="origin-name">{s.name}</span>
                      <span class="origin-location">{s.origin}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <div class="landrace-note">
        <span class="landrace-icon">🏴</span>
        <div>
          <strong>About Landraces</strong>
          <p>Landrace strains are cannabis varieties that evolved naturally in their geographic region over centuries without human hybridization. They form the genetic foundation of virtually all modern cannabis. Landraces include Hindu Kush, Afghani, Durban Poison, Thai Stick, Acapulco Gold, and Panama Red.</p>
        </div>
      </div>
    </section>

  </main>

  <script>
    // ── DOM refs ────────────────────────────────────────────────────
    const grid      = document.getElementById('strainsGrid')!;
    const cards     = Array.from(grid.querySelectorAll<HTMLElement>('.strain-card'));
    const searchEl  = document.getElementById('strainSearch') as HTMLInputElement;
    const filterBtns= Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    const sortEl    = document.getElementById('sortSelect') as HTMLSelectElement;
    const emptyState= document.getElementById('emptyState')!;

    let activeFilter = 'all';
    let searchTerm   = '';

    // ── Filter + Search ─────────────────────────────────────────────
    function applyFilters() {
      let visible = 0;
      cards.forEach(card => {
        const type = card.dataset.type ?? '';
        const name = card.dataset.name ?? '';
        const matchesFilter = activeFilter === 'all' || type === activeFilter;
        const matchesSearch = name.includes(searchTerm.toLowerCase().trim());
        if (matchesFilter && matchesSearch) {
          card.classList.remove('hidden');
          visible++;
        } else {
          card.classList.add('hidden');
        }
      });
      emptyState.classList.toggle('hidden', visible > 0);
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeFilter = btn.dataset.filter ?? 'all';
        applyFilters();
      });
    });

    searchEl.addEventListener('input', () => {
      searchTerm = searchEl.value;
      applyFilters();
    });

    // ── Sort ────────────────────────────────────────────────────────
    sortEl.addEventListener('change', () => {
      const order = sortEl.value;
      const sorted = [...cards].sort((a, b) => {
        if (order === 'name') {
          return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
        }
        if (order === 'thc') {
          return parseFloat(b.dataset.thc ?? '0') - parseFloat(a.dataset.thc ?? '0');
        }
        if (order === 'type') {
          const order2 = ['indica','sativa','hybrid'];
          return order2.indexOf(a.dataset.type ?? '') - order2.indexOf(b.dataset.type ?? '');
        }
        return 0;
      });
      sorted.forEach(card => grid.appendChild(card));
    });

    // ── Expand / Collapse ────────────────────────────────────────────
    grid.addEventListener('click', (e: Event) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLButtonElement>('.expand-btn');
      if (!btn) return;
      const idx     = btn.dataset.card ?? '';
      const panel   = document.getElementById(`expand-${idx}`);
      const arrow   = btn.querySelector('.expand-arrow');
      if (!panel) return;
      const isOpen  = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
      btn.textContent = '';
      btn.innerHTML = isOpen
        ? `Show Details <span class="expand-arrow">▾</span>`
        : `Hide Details <span class="expand-arrow" style="transform:rotate(180deg);display:inline-block">▾</span>`;
    });
  </script>

</Layout>

