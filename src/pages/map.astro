---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="US Cannabis Legal Map" description="Interactive map of cannabis legal status across all 50 US states and D.C.">

<div class="map-page">

  <!-- Page Header -->
  <div class="map-page-header">
    <div class="container">
      <h1 class="map-page-title">🗺️ US Cannabis Legal Map</h1>
      <p class="map-page-subtitle">
        Explore cannabis legal status across all 50 states and Washington D.C. Click any state to view
        dispensaries and local regulations. Data current as of 2025.
      </p>

      <!-- Stats Bar -->
      <div class="map-stats-bar">
        <div class="map-stat-item">
          <span class="map-stat-dot" style="background:#4ade80"></span>
          <span class="map-stat-count">26</span>
          <span class="map-stat-label">Fully Legal</span>
        </div>
        <div class="map-stat-div"></div>
        <div class="map-stat-item">
          <span class="map-stat-dot" style="background:#fbbf24"></span>
          <span class="map-stat-count">18</span>
          <span class="map-stat-label">Medical Only</span>
        </div>
        <div class="map-stat-div"></div>
        <div class="map-stat-item">
          <span class="map-stat-dot" style="background:#60a5fa"></span>
          <span class="map-stat-count">2</span>
          <span class="map-stat-label">Decriminalized</span>
        </div>
        <div class="map-stat-div"></div>
        <div class="map-stat-item">
          <span class="map-stat-dot" style="background:#f87171"></span>
          <span class="map-stat-count">5</span>
          <span class="map-stat-label">Illegal</span>
        </div>
      </div>

      <!-- Legend -->
      <div class="map-legend">
        <div class="map-legend-item">
          <span class="map-legend-swatch" style="background:#4ade80"></span>
          <span>Fully Legal <small>(recreational + medical)</small></span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-swatch" style="background:#fbbf24"></span>
          <span>Medical Only</span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-swatch" style="background:#60a5fa"></span>
          <span>Decriminalized</span>
        </div>
        <div class="map-legend-item">
          <span class="map-legend-swatch" style="background:#f87171"></span>
          <span>Illegal</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Map Container -->
  <div class="container">
    <div class="map-wrapper">
      <div id="map-loading" class="map-loading">Loading map…</div>
      <svg
        id="us-map"
        aria-label="Interactive US Cannabis Legal Status Map"
        role="img"
        style="display:none"
      ></svg>
    </div>

    <!-- Tooltip -->
    <div id="map-tooltip" class="map-tooltip" style="display:none">
      <span id="map-tooltip-state"></span>
      <span id="map-tooltip-badge" class="map-status-badge"></span>
    </div>
  </div>

  <!-- Slide-in Panel -->
  <div id="state-panel" class="state-panel" role="dialog" aria-modal="true" aria-label="State cannabis information">
    <button class="panel-close" id="panel-close" aria-label="Close panel">×</button>
    <div class="panel-header">
      <h2 id="panel-state-name"></h2>
      <span id="panel-status-badge" class="map-status-badge map-status-badge-lg"></span>
    </div>
    <div class="panel-body" id="panel-body"></div>
  </div>
  <div id="panel-overlay" class="panel-overlay"></div>

</div><!-- end map-page -->

</Layout>

<style>
  /* ---- Page wrapper ---- */
  .map-page {
    padding-bottom: 4rem;
  }

  /* ---- Header ---- */
  .map-page-header {
    text-align: center;
    padding: 3rem 0 2rem;
    background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg) 100%);
  }
  .map-page-title {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.6rem;
    letter-spacing: -0.5px;
  }
  .map-page-subtitle {
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 640px;
    margin: 0 auto 1.5rem;
    line-height: 1.7;
  }

  /* ---- Stats Bar ---- */
  .map-stats-bar {
    display: inline-flex;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 50px;
    padding: 0.5rem 1.5rem;
    margin-bottom: 1.4rem;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
  }
  .map-stat-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.9rem;
  }
  .map-stat-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .map-stat-count {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }
  .map-stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .map-stat-div {
    width: 1px;
    height: 24px;
    background: var(--border);
  }

  /* ---- Legend ---- */
  .map-legend {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .map-legend-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.87rem;
    color: var(--text);
  }
  .map-legend-swatch {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .map-legend-item small {
    color: var(--text-muted);
  }

  /* ---- Map wrapper ---- */
  .map-wrapper {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.25rem;
    overflow: hidden;
    max-width: 960px;
    margin: 0 auto;
  }

  /* ---- Loading state ---- */
  .map-loading {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
    font-size: 1rem;
    font-style: italic;
  }

  /* ---- SVG map ---- */
  #us-map {
    width: 100%;
    height: auto;
    display: block;
  }

  /* State paths — base styles set here, D3 sets fill inline */
  #us-map .state {
    stroke: #ffffff;
    stroke-width: 0.8;
    cursor: pointer;
    transition: opacity 0.15s ease, stroke-width 0.15s ease;
  }
  #us-map .state:hover {
    opacity: 0.82;
    stroke-width: 1.8;
  }
  #us-map .state.map-active {
    opacity: 1;
    stroke: #ffffff;
    stroke-width: 2.5;
    filter: brightness(1.12) drop-shadow(0 0 6px rgba(0,0,0,0.35));
  }

  /* State labels */
  #us-map .state-label {
    pointer-events: none;
    user-select: none;
    font-family: Inter, system-ui, sans-serif;
  }

  /* ---- Tooltip ---- */
  .map-tooltip {
    position: fixed;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.4rem 0.8rem;
    pointer-events: none;
    z-index: 250;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text);
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }

  /* ---- Status Badges ---- */
  .map-status-badge {
    display: inline-block;
    padding: 0.18rem 0.6rem;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .map-status-badge-lg {
    padding: 0.28rem 0.85rem;
    font-size: 0.76rem;
  }
  .badge-fully-legal    { background: rgba(22,163,74,0.12);  color: #15803d; border: 1px solid rgba(22,163,74,0.35); }
  .badge-medical        { background: rgba(180,83,9,0.10);   color: #b45309; border: 1px solid rgba(180,83,9,0.3); }
  .badge-decriminalized { background: rgba(37,99,235,0.10);  color: #1d4ed8; border: 1px solid rgba(37,99,235,0.3); }
  .badge-illegal        { background: rgba(220,38,38,0.10);  color: #dc2626; border: 1px solid rgba(220,38,38,0.25); }

  /* ---- Slide-in Panel ---- */
  .panel-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    z-index: 299;
    backdrop-filter: blur(2px);
  }
  .panel-overlay.open { display: block; }

  .state-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 390px;
    max-width: 96vw;
    height: 100%;
    background: var(--bg-card);
    border-left: 1px solid var(--border);
    z-index: 300;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }
  .state-panel.open {
    transform: translateX(0);
    box-shadow: -8px 0 40px rgba(0,0,0,0.18);
  }
  .panel-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--border);
    border: none;
    color: var(--text-muted);
    font-size: 1.3rem;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: background 0.2s, color 0.2s;
    z-index: 1;
  }
  .panel-close:hover {
    background: var(--primary);
    color: #ffffff;
  }
  .panel-header {
    padding: 1.5rem 3.5rem 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .panel-header h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }
  .panel-body {
    padding: 1.25rem 1.5rem;
    flex: 1;
  }

  /* ---- Panel content ---- */
  .panel-law-note {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    margin-bottom: 1.2rem;
    font-size: 0.87rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .panel-law-note p { margin: 0; color: var(--text-muted); }
  .panel-section-label {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }
  .panel-disp-card {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    margin-bottom: 0.6rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    transition: border-color 0.2s;
    cursor: default;
  }
  .panel-disp-card:hover { border-color: rgba(74,222,128,0.4); }
  .panel-disp-icon { font-size: 1.15rem; flex-shrink: 0; margin-top: 0.05rem; }
  .panel-disp-info { flex: 1; min-width: 0; }
  .panel-disp-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.18rem;
    line-height: 1.35;
  }
  .panel-disp-city {
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 0.12rem;
  }
  .panel-disp-address {
    font-size: 0.74rem;
    color: var(--text-muted);
  }
  .panel-illegal-msg {
    background: rgba(248,113,113,0.07);
    border: 1px solid rgba(248,113,113,0.25);
    border-radius: 10px;
    padding: 1rem 1.1rem;
    color: #991b1b;
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .panel-illegal-msg strong { color: #dc2626; }
  .panel-no-disp {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  /* ---- Responsive ---- */
  @media (max-width: 640px) {
    .map-page-title { font-size: 1.8rem; }
    .map-stats-bar { padding: 0.4rem 0.6rem; }
    .map-stat-item { padding: 0.2rem 0.5rem; }
    .map-stat-label { display: none; }
    .map-legend { gap: 0.8rem; }
    .state-panel { width: 100%; max-width: 100%; }
  }
</style>

