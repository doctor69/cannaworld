  // ===================================================================
  // ICONS
  // ===================================================================
  const DISP_ICONS = ['🌿','💚','🍃','🌱','✨'];

  // ===================================================================
  // PANEL HELPERS
  // ===================================================================
  function escHtml(s) {
    return String(s)
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;');
  }

  const panel     = document.getElementById('state-panel');
  const overlay   = document.getElementById('panel-overlay');
  const btnClose  = document.getElementById('panel-close');
  const panelName = document.getElementById('panel-state-name');
  const panelBadge= document.getElementById('panel-status-badge');
  const panelBody = document.getElementById('panel-body');
  const tooltip   = document.getElementById('map-tooltip');
  const ttState   = document.getElementById('map-tooltip-state');
  const ttBadge   = document.getElementById('map-tooltip-badge');

  let activeEl = null;

  function showPanel(abbr) {
    const data = stateData[abbr];
    if (!data) return;

    panelName.textContent  = data.name;
    panelBadge.textContent = statusLabels[data.status] || data.status;
    panelBadge.className   = `map-status-badge map-status-badge-lg badge-${data.status}`;

    if (data.status === 'illegal') {
      panelBody.innerHTML = `
        <div class="panel-illegal-msg">
          <strong>⚠️ Cannabis is not legally available in ${escHtml(data.name)}.</strong>
          <br><br>${escHtml(data.lawNote)}
        </div>`;
    } else {
      const cards = data.dispensaries && data.dispensaries.length
        ? data.dispensaries.map((d, i) => `
            <div class="panel-disp-card">
              <span class="panel-disp-icon">${DISP_ICONS[i % DISP_ICONS.length]}</span>
              <div class="panel-disp-info">
                <div class="panel-disp-name">${escHtml(d.name)}</div>
                <div class="panel-disp-city">📍 ${escHtml(d.city)}</div>
                <div class="panel-disp-address">${escHtml(d.address)}</div>
              </div>
            </div>`).join('')
        : '<p class="panel-no-disp">No licensed dispensaries currently listed.</p>';

      panelBody.innerHTML = `
        <div class="panel-law-note"><p>📋 ${escHtml(data.lawNote)}</p></div>
        <div class="panel-section-label">Dispensaries in ${escHtml(data.name)}</div>
        ${cards}`;
    }

    panel.classList.add('open');
    overlay.classList.add('open');
  }

  function closePanel() {
    panel.classList.remove('open');
    overlay.classList.remove('open');
    if (activeEl) {
      activeEl.classed('map-active', false);
      activeEl = null;
    }
  }

  btnClose.addEventListener('click', closePanel);
  overlay.addEventListener('click', closePanel);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

  // ===================================================================
  // D3 MAP INIT
  // ===================================================================
  async function initMap() {
    const loadingEl = document.getElementById('map-loading');
    const svgEl     = document.getElementById('us-map');

    try {
      const [d3, topojson, us] = await Promise.all([
        import('https://cdn.jsdelivr.net/npm/d3@7/+esm'),
        import('https://cdn.jsdelivr.net/npm/topojson-client@3/+esm'),
        fetch('https://cdn.jsdelivr.net/npm/us-atlas@3/states-10m.json').then(r => r.json())
      ]);

      const width  = 960;
      const height = 600;

      const projection = d3.geoAlbersUsa()
        .scale(1300)
        .translate([width / 2, height / 2]);

      const path = d3.geoPath().projection(projection);

      const svg = d3.select('#us-map')
        .attr('viewBox', `0 0 ${width} ${height}`)
        .attr('width', '100%')
        .attr('height', 'auto');

      const states = topojson.feature(us, us.objects.states);

      // ---- Draw state fills ----
      svg.selectAll('path.state')
        .data(states.features)
        .join('path')
        .attr('class', 'state')
        .attr('d', path)
        .attr('fill', d => {
          const abbr   = fipsToAbbr[String(d.id).padStart(2, '0')];
          const status = legalStatus[abbr] || 'illegal';
          return statusColors[status];
        })
        .attr('stroke', '#ffffff')
        .attr('stroke-width', 0.8)
        .style('cursor', 'pointer')
        // Tooltip on hover
        .on('mousemove', function(event, d) {
          const abbr   = fipsToAbbr[String(d.id).padStart(2, '0')];
          const status = legalStatus[abbr] || 'illegal';
          const name   = stateData[abbr] ? stateData[abbr].name : abbr;
          ttState.textContent = name;
          ttBadge.textContent = statusLabels[status] || status;
          ttBadge.className   = `map-status-badge badge-${status}`;
          tooltip.style.display = 'flex';
          let x = event.clientX + 14;
          let y = event.clientY + 14;
          if (x + 260 > window.innerWidth)  x = event.clientX - 260;
          if (y + 60  > window.innerHeight) y = event.clientY - 60;
          tooltip.style.left = x + 'px';
          tooltip.style.top  = y + 'px';
        })
        .on('mouseleave', function() {
          tooltip.style.display = 'none';
        })
        .on('click', function(event, d) {
          tooltip.style.display = 'none';
          // Remove previous active highlight
          if (activeEl) activeEl.classed('map-active', false);
          activeEl = d3.select(this);
          activeEl.classed('map-active', true);
          // Bring active state to top visually (raise in DOM)
          activeEl.raise();
          const abbr = fipsToAbbr[String(d.id).padStart(2, '0')];
          showPanel(abbr);
        });

      // ---- State border mesh ----
      svg.append('path')
        .datum(topojson.mesh(us, us.objects.states, (a, b) => a !== b))
        .attr('fill', 'none')
        .attr('stroke', '#ffffff')
        .attr('stroke-width', 0.5)
        .attr('stroke-linejoin', 'round')
        .attr('pointer-events', 'none');

      // ---- State abbreviation labels ----
      svg.selectAll('text.state-label')
        .data(states.features)
        .join('text')
        .attr('class', 'state-label')
        .attr('x', d => {
          const c = path.centroid(d);
          return isNaN(c[0]) ? -9999 : c[0];
        })
        .attr('y', d => {
          const c = path.centroid(d);
          return isNaN(c[1]) ? -9999 : c[1];
        })
        .attr('text-anchor', 'middle')
        .attr('dominant-baseline', 'middle')
        .attr('font-size', '8')
        .attr('font-weight', '700')
        .attr('fill', '#1a2e1f')
        .attr('pointer-events', 'none')
        .text(d => {
          const abbr = fipsToAbbr[String(d.id).padStart(2, '0')] || '';
          // Skip label for very small states — they overlap; handled below
          return abbr;
        });

      // Show map, hide loader
      loadingEl.style.display = 'none';
      svgEl.style.display = 'block';

    } catch (err) {
      console.error('Map failed to load:', err);
      loadingEl.textContent = 'Map could not load. Please check your connection and refresh.';
    }
  }

  initMap();
</script>

</Layout>
