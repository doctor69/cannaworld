---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="Home" description="CannaWorld — the definitive educational resource on cannabis: US state legal map, strain guide, 5,000 years of history, and the latest health science.">

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="hero-eyebrow">🌿 Knowledge is Power.</div>
        <h1>The Definitive Cannabis <span class="hero-highlight">Atlas</span></h1>
        <p class="hero-sub">
          A comprehensive, science-based educational resource covering legal status across all 50 states,
          5,000+ cannabis strains, 5,000 years of human history, and peer-reviewed health research —
          all in one place.
        </p>
        <div class="hero-cta">
          <a href={`${base}map`} class="btn btn-primary">Explore Legal Map →</a>
          <a href={`${base}strains`} class="btn btn-outline">Browse Strains →</a>
          <a href={`${base}health`} class="btn btn-outline">Health & Science →</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hs-num">50</span>
            <span>States Mapped</span>
          </div>
          <div class="hero-stat">
            <span class="hs-num" style="color:var(--accent-teal)">5,000+</span>
            <span>Strains</span>
          </div>
          <div class="hero-stat">
            <span class="hs-num" style="color:var(--accent-gold)">5,000</span>
            <span>Years of History</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="canna-wheel">
          {['🌿','🧪','🗺️','🔬','🌱','💊','🏥','📖','⚗️','🌍','🌾','🧬'].map((emoji, i) => (
            <div class="cw-item" style={`--i:${i}`}>{emoji}</div>
          ))}
          <div class="cw-center">🌿</div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IS CANNAWORLD -->
  <section class="section-alt">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow">What is CannaWorld?</div>
        <h2>Four Pillars of Cannabis Knowledge</h2>
        <p>
          CannaWorld is built for curious minds — students, researchers, patients, advocates, and
          policymakers who want accurate, unbiased information about one of the world's most studied and
          most misunderstood plants.
        </p>
      </div>
      <div class="grid-4">
        <a href={`${base}map`} class="pillar-card">
          <div class="pillar-icon" style="background:linear-gradient(135deg,#16a34a,#4ade80)">🗺️</div>
          <h3>Legal Map</h3>
          <p>Interactive state-by-state breakdown of recreational, medical, and decriminalized status across all 50 states plus DC.</p>
          <span class="pillar-link">Explore →</span>
        </a>
        <a href={`${base}strains`} class="pillar-card">
          <div class="pillar-icon" style="background:linear-gradient(135deg,#0d9488,#2dd4bf)">🌿</div>
          <h3>Strain Guide</h3>
          <p>5,000+ documented strains with cannabinoid profiles, terpene charts, reported effects, and cultivation notes.</p>
          <span class="pillar-link">Explore →</span>
        </a>
        <a href={`${base}history`} class="pillar-card">
          <div class="pillar-icon" style="background:linear-gradient(135deg,#b45309,#fbbf24)">📖</div>
          <h3>History</h3>
          <p>From ancient Chinese medicine to the Silk Road, colonial hemp farming, Reefer Madness, and today's legalization wave.</p>
          <span class="pillar-link">Explore →</span>
        </a>
        <a href={`${base}health`} class="pillar-card">
          <div class="pillar-icon" style="background:linear-gradient(135deg,#6d28d9,#a78bfa)">🔬</div>
          <h3>Health & Science</h3>
          <p>The endocannabinoid system, CBD vs THC, clinical research summaries, and what the peer-reviewed literature actually says.</p>
          <span class="pillar-link">Explore →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- QUICK FACTS -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow">By the Numbers</div>
        <h2>Cannabis in the United States — 2024</h2>
        <p>The legal and economic landscape has shifted dramatically in the past decade. Here's where things stand today.</p>
      </div>
      <div class="grid-4">
        <div class="stat-card">
          <div class="stat-number" style="color:var(--primary)">21</div>
          <div class="stat-label" style="font-weight:600;color:var(--text);margin-bottom:0.25rem;">States Fully Legal</div>
          <div class="stat-label">Recreational adult-use cannabis is legal for adults 21+</div>
        </div>
        <div class="stat-card">
          <div class="stat-number" style="color:var(--accent-gold)">38</div>
          <div class="stat-label" style="font-weight:600;color:var(--text);margin-bottom:0.25rem;">States — Medical Legal</div>
          <div class="stat-label">Medical cannabis programs serving qualifying patients</div>
        </div>
        <div class="stat-card">
          <div class="stat-number" style="color:var(--accent-teal)">$30B+</div>
          <div class="stat-label" style="font-weight:600;color:var(--text);margin-bottom:0.25rem;">US Market Size (2024)</div>
          <div class="stat-label">Legal cannabis sales in the United States last year</div>
        </div>
        <div class="stat-card">
          <div class="stat-number" style="color:var(--accent-purple)">1937</div>
          <div class="stat-label" style="font-weight:600;color:var(--text);margin-bottom:0.25rem;">Federal Prohibition Began</div>
          <div class="stat-label">The Marihuana Tax Act — the start of federal criminalization</div>
        </div>
      </div>
    </div>
  </section>

  <!-- US LEGAL STATUS BANNER -->
  <section class="legal-banner">
    <div class="container">
      <div class="legal-banner-inner">
        <div class="lb-header">
          <div class="eyebrow" style="color:var(--primary);margin-bottom:0.4rem;">US Legal Landscape</div>
          <h2 style="font-size:1.6rem;margin-bottom:0.5rem;">Where Does Your State Stand?</h2>
          <p style="color:#4b6358;font-size:0.95rem;margin:0;">Laws change rapidly. Check our live map for the most current status in every state.</p>
        </div>
        <div class="lb-statuses">
          <div class="lb-status">
            <span class="lb-dot" style="background:#4ade80;box-shadow:0 0 10px rgba(74,222,128,0.6)"></span>
            <div>
              <div class="lb-status-label">Fully Legal</div>
              <div class="lb-status-desc">Adult-use &amp; medical — 21 states + DC</div>
            </div>
          </div>
          <div class="lb-status">
            <span class="lb-dot" style="background:#fbbf24;box-shadow:0 0 10px rgba(251,191,36,0.5)"></span>
            <div>
              <div class="lb-status-label">Medical Only</div>
              <div class="lb-status-desc">Qualifying patients only — 17 states</div>
            </div>
          </div>
          <div class="lb-status">
            <span class="lb-dot" style="background:#f87171;box-shadow:0 0 10px rgba(248,113,113,0.5)"></span>
            <div>
              <div class="lb-status-label">Fully Illegal</div>
              <div class="lb-status-desc">All use prohibited — 12 states</div>
            </div>
          </div>
        </div>
        <a href={`${base}map`} class="btn btn-primary lb-btn">View Full Legal Map →</a>
      </div>
    </div>
  </section>

  <!-- STRAIN SPOTLIGHT -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow">Strain Guide Preview</div>
        <h2>Understanding Cannabis Types</h2>
        <p>Cannabis strains are broadly categorized by their genetic heritage and cannabinoid profiles. Each produces a distinct experience.</p>
      </div>
      <div class="grid-3">
        {[
          {
            type: 'Sativa',
            emoji: '🌿',
            color: '#16a34a',
            badge: 'badge-green',
            tagline: 'Uplifting · Energizing · Cerebral',
            desc: 'Sativa-dominant strains are typically associated with a more energizing, cerebral experience. Often used for daytime activity, creative work, and social settings.',
            cannabinoids: 'THC: High · CBD: Low',
            origins: 'Equatorial regions — Colombia, Thailand, Mexico',
            examples: ['Sour Diesel', 'Jack Herer', 'Durban Poison'],
          },
          {
            type: 'Indica',
            emoji: '🌱',
            color: '#7c3aed',
            badge: 'badge-purple',
            tagline: 'Relaxing · Sedating · Body-focused',
            desc: 'Indica-dominant strains are typically associated with full-body relaxation. Historically used for pain management, sleep, and anxiety relief in evening settings.',
            cannabinoids: 'THC: Moderate-High · CBD: Variable',
            origins: 'Hindu Kush mountain range — Afghanistan, Pakistan',
            examples: ['Granddaddy Purple', 'OG Kush', 'Northern Lights'],
          },
          {
            type: 'Hybrid',
            emoji: '⚗️',
            color: '#0d9488',
            badge: 'badge-teal',
            tagline: 'Balanced · Versatile · Complex',
            desc: 'Most modern strains are hybrids, combining traits from both sativa and indica lineages. Effects depend heavily on specific cannabinoid and terpene profiles.',
            cannabinoids: 'THC/CBD: Variable by cultivar',
            origins: 'Selectively bred — worldwide',
            examples: ['Blue Dream', 'Girl Scout Cookies', 'Gelato'],
          },
        ].map(s => (
          <div class="strain-card" style={`border-top:3px solid ${s.color}`}>
            <div class="sc-header">
              <span class="sc-emoji">{s.emoji}</span>
              <div>
                <h3 style={`color:${s.color};margin-bottom:0.2rem;`}>{s.type}</h3>
                <span class={`badge ${s.badge}`}>{s.tagline}</span>
              </div>
            </div>
            <p style="font-size:0.9rem;line-height:1.65;margin-bottom:1rem;">{s.desc}</p>
            <div class="sc-meta">
              <div class="sc-meta-row">
                <span class="sc-meta-label">Cannabinoids</span>
                <span class="sc-meta-val">{s.cannabinoids}</span>
              </div>
              <div class="sc-meta-row">
                <span class="sc-meta-label">Origins</span>
                <span class="sc-meta-val">{s.origins}</span>
              </div>
              <div class="sc-meta-row">
                <span class="sc-meta-label">Known examples</span>
                <span class="sc-meta-val">{s.examples.join(', ')}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-4">
        <a href={`${base}strains`} class="btn btn-outline">Browse All 5,000+ Strains →</a>
      </div>
    </div>
  </section>

  <!-- HISTORY TIMELINE TEASER -->
  <section class="section-alt">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow">5,000 Years of History</div>
        <h2>Cannabis Through the Ages</h2>
        <p>From ancient ceremonial use to prohibition and the modern legalization movement — cannabis has one of the longest and most complex histories of any plant.</p>
      </div>
      <div class="timeline">
        {[
          { year: '2727 BCE', label: 'Ancient China', desc: 'Emperor Shen Nung documents cannabis in one of the world\'s first pharmacopeias as medicine for gout, rheumatism, and malaria.', color: 'var(--accent-gold)' },
          { year: '1000 BCE', label: 'Vedic India', desc: 'The Atharva Veda names cannabis (bhang) as one of the five sacred plants, used in ritual, medicine, and recreation.', color: 'var(--accent-teal)' },
          { year: '1611', label: 'Colonial America', desc: 'Jamestown colonists are legally required to grow hemp for rope, sails, and clothing. Hemp was legal tender in Virginia, Maryland & Pennsylvania.', color: 'var(--primary)' },
          { year: '1937', label: 'Federal Prohibition', desc: 'The Marihuana Tax Act effectively bans cannabis in the US. The AMA opposes the bill, saying it contradicts accepted medical practice.', color: '#f87171' },
          { year: '1996', label: 'California Goes First', desc: 'Proposition 215 makes California the first US state to legalize medical cannabis, igniting the modern reform movement.', color: 'var(--accent-gold)' },
          { year: '2012', label: 'Recreational Era Begins', desc: 'Colorado and Washington become the first states to legalize recreational adult-use cannabis via ballot initiative.', color: 'var(--primary)' },
        ].map((ev, i) => (
          <div class="tl-item">
            <div class="tl-line">
              <div class="tl-dot" style={`background:${ev.color};box-shadow:0 0 10px ${ev.color}60`}></div>
              {i < 5 && <div class="tl-connector"></div>}
            </div>
            <div class="tl-body">
              <div class="tl-year" style={`color:${ev.color}`}>{ev.year}</div>
              <div class="tl-event">{ev.label}</div>
              <p style="font-size:0.88rem;line-height:1.6;margin:0;">{ev.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-4">
        <a href={`${base}history`} class="btn btn-outline">Read Full History →</a>
      </div>
    </div>
  </section>

  <!-- HEALTH & SCIENCE PREVIEW -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow">Science & Research</div>
        <h2>What the Research Actually Says</h2>
        <p>Cutting through the noise with peer-reviewed science. Cannabis research has accelerated rapidly since legalization expanded access for scientists.</p>
      </div>
      <div class="grid-3" style="margin-bottom:3rem;">
        {[
          { icon: '🧠', title: 'The Endocannabinoid System', desc: 'Discovered in the 1990s, the ECS is one of the most widespread receptor systems in the human body, regulating pain, mood, appetite, memory, and immune function.', badge: 'Foundational Science', badgeClass: 'badge-green' },
          { icon: '🌡️', title: 'CBD & Inflammation', desc: 'Multiple clinical trials show CBD has significant anti-inflammatory properties. The FDA-approved drug Epidiolex (CBD) has proven efficacy for certain epilepsy syndromes.', badge: 'Clinical Evidence', badgeClass: 'badge-teal' },
          { icon: '⚠️', title: 'Understanding the Risks', desc: 'Adolescent brain development, dependency risk (estimated 9% lifetime rate), and drug interactions are real concerns that the research community continues to study.', badge: 'Risk Factors', badgeClass: 'badge-red' },
        ].map(h => (
          <div class="health-card">
            <div class="hc-icon">{h.icon}</div>
            <h3 style="margin-bottom:0.5rem;">{h.title}</h3>
            <span class={`badge ${h.badgeClass}`} style="margin-bottom:0.75rem;display:inline-block;">{h.badge}</span>
            <p style="font-size:0.9rem;line-height:1.65;">{h.desc}</p>
          </div>
        ))}
      </div>
      <div class="highlight-box highlight-green">
        <strong style="color:var(--primary);">Scientific Nuance:</strong>
        <span style="color:var(--text-muted);"> Cannabis research is rapidly evolving. CannaWorld cites peer-reviewed sources and clearly labels findings by evidence quality — always distinguishing between anecdotal reports, observational studies, and randomized controlled trials.</span>
      </div>
    </div>
  </section>

  <!-- LEGAL STATUS EXPLAINER STRIP -->
  <section class="status-strip">
    <div class="container">
      <div class="ss-inner">
        <div class="ss-item ss-full">
          <div class="ss-icon">🟢</div>
          <div class="ss-label">Fully Legal</div>
          <div class="ss-desc">Adults 21+ can purchase, possess, and in most states home-grow cannabis. Licensed dispensaries operate openly.</div>
        </div>
        <div class="ss-divider"></div>
        <div class="ss-item ss-medical">
          <div class="ss-icon">🟡</div>
          <div class="ss-label">Medical Only</div>
          <div class="ss-desc">Patients with qualifying conditions can access cannabis through a licensed dispensary with a physician's recommendation.</div>
        </div>
        <div class="ss-divider"></div>
        <div class="ss-item ss-illegal">
          <div class="ss-icon">🔴</div>
          <div class="ss-label">Fully Illegal</div>
          <div class="ss-desc">All possession and use is criminalized. Penalties range from fines to felony charges depending on quantity.</div>
        </div>
        <div class="ss-cta">
          <a href={`${base}map`} class="btn btn-primary" style="white-space:nowrap;">See Your State →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="cta-banner">
    <div class="container text-center">
      <h2 style="color:#fff;font-size:2rem;margin-bottom:0.75rem;">Ready to Learn More?</h2>
      <p style="color:rgba(226,232,240,0.8);max-width:520px;margin:0 auto 2rem;font-size:1.05rem;">
        Start with the legal map to understand your local laws, explore strains by effect profile, or dive deep into the science of how cannabis interacts with the human body.
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href={`${base}map`} class="btn btn-primary">🗺️ Legal Map</a>
        <a href={`${base}strains`} class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:#fff;">🌿 Strain Guide</a>
        <a href={`${base}health`} class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:#fff;">🔬 Health Science</a>
      </div>
    </div>
  </section>

  <!-- DISCLAIMER -->
  <section class="disclaimer">
    <div class="container">
      <div class="disclaimer-inner">
        <div class="disc-row">
          <span class="disc-badge">18+ / 21+</span>
          <span class="disc-text">This website is intended for adults only. You must be of legal age in your jurisdiction to access cannabis-related content.</span>
        </div>
        <div class="disc-row">
          <span class="disc-badge">Educational Only</span>
          <span class="disc-text">All content on CannaWorld is for educational and informational purposes. Nothing here constitutes medical, legal, or financial advice. Consult qualified professionals before making health or legal decisions.</span>
        </div>
        <div class="disc-row">
          <span class="disc-badge">Know Your Laws</span>
          <span class="disc-text">Cannabis laws vary dramatically by state, county, and municipality. Laws change frequently. Always verify current regulations with official government sources before acting.</span>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Hero grid layout */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding: 5rem 1.5rem;
  }
  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  /* Cannabis Wheel */
  .hero-visual { display: flex; align-items: center; justify-content: center; }
  .canna-wheel {
    position: relative;
    width: 340px;
    height: 340px;
  }
  .cw-item {
    position: absolute;
    font-size: 1.9rem;
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 50%;
    box-shadow: 0 0 20px rgba(74,222,128,0.08);
    top: 50%;
    left: 50%;
    transform-origin: 0 0;
    transform: rotate(calc(var(--i) * 30deg)) translateX(130px) rotate(calc(var(--i) * -30deg)) translate(-50%, -50%);
    animation: cwfloat 4s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.33s);
  }
  .cw-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 2.5rem;
    width: 86px;
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #14532d, #16a34a);
    border: 2px solid rgba(74,222,128,0.4);
    border-radius: 50%;
    box-shadow: 0 0 40px rgba(74,222,128,0.2);
  }
  @keyframes cwfloat {
    0%, 100% { transform: rotate(calc(var(--i) * 30deg)) translateX(130px) rotate(calc(var(--i) * -30deg)) translate(-50%, -50%) translateY(0); }
    50%       { transform: rotate(calc(var(--i) * 30deg)) translateX(130px) rotate(calc(var(--i) * -30deg)) translate(-50%, -50%) translateY(-7px); }
  }

  /* Pillar cards */
  .pillar-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.75rem 1.5rem;
    display: block;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .pillar-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); border-color: rgba(74,222,128,0.35); }
  .pillar-icon {
    width: 58px; height: 58px;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.65rem;
    margin-bottom: 1.1rem;
  }
  .pillar-card h3 { margin-bottom: 0.5rem; font-size: 1.05rem; color: var(--text); }
  .pillar-card p { font-size: 0.88rem; line-height: 1.6; margin-bottom: 1rem; }
  .pillar-link { font-size: 0.88rem; font-weight: 700; color: var(--primary); }

  /* Legal banner */
  .legal-banner {
    background: linear-gradient(135deg, #eaf2ed 0%, #f0f7f3 100%);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 4rem 0;
  }
  .legal-banner-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .lb-header { flex: 1; min-width: 200px; }
  .lb-statuses { display: flex; flex-direction: column; gap: 1rem; flex: 1; min-width: 200px; }
  .lb-status { display: flex; align-items: center; gap: 0.85rem; }
  .lb-dot { width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0; }
  .lb-status-label { font-weight: 700; font-size: 0.95rem; color: var(--text); margin-bottom: 0.1rem; }
  .lb-status-desc { font-size: 0.83rem; color: var(--text-muted); }
  .lb-btn { flex-shrink: 0; }

  /* Strain cards */
  .strain-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .strain-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .sc-header { display: flex; align-items: flex-start; gap: 0.85rem; margin-bottom: 0.85rem; }
  .sc-emoji { font-size: 2rem; line-height: 1; }
  .sc-meta { margin-top: 0.75rem; border-top: 1px solid var(--border); padding-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .sc-meta-row { display: flex; flex-direction: column; gap: 0.1rem; }
  .sc-meta-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); }
  .sc-meta-val { font-size: 0.85rem; color: var(--text); }

  /* Timeline */
  .timeline { display: flex; flex-direction: column; gap: 0; }
  .tl-item { display: flex; gap: 1.5rem; }
  .tl-line { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
  .tl-dot { width: 16px; height: 16px; border-radius: 50%; flex-shrink: 0; margin-top: 0.35rem; }
  .tl-connector { width: 2px; background: var(--border-light); flex: 1; margin: 4px 0; min-height: 1.5rem; }
  .tl-body { padding-bottom: 2rem; }
  .tl-year { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.15rem; }
  .tl-event { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 0.4rem; }

  /* Health cards */
  .health-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
