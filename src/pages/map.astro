  const statusLabels = {
    'fully-legal':    'Fully Legal',
    'medical':        'Medical Only',
    'decriminalized': 'Decriminalized',
    'illegal':        'Illegal',
  };

  const DISP_ICONS = ['🌿','💚','🍃','🌱','✨'];

  // ===================================================================
  // INIT MAP
  // ===================================================================
  (function initMap() {
    const svg       = document.getElementById('us-map');
    const tooltip   = document.getElementById('map-tooltip');
    const ttState   = document.getElementById('map-tooltip-state');
    const ttBadge   = document.getElementById('map-tooltip-badge');
    const panel     = document.getElementById('state-panel');
    const overlay   = document.getElementById('panel-overlay');
    const btnClose  = document.getElementById('panel-close');
    const panelName = document.getElementById('panel-state-name');
    const panelBadge= document.getElementById('panel-status-badge');
    const panelBody = document.getElementById('panel-body');

    let activeEl = null;

    // Apply CSS status classes to all SVG paths/circles
    svg.querySelectorAll('[data-status]').forEach(el => {
      el.classList.add('status-' + el.getAttribute('data-status'));
    });

    // ---- Tooltip on mousemove ----
    svg.addEventListener('mousemove', (e) => {
      const target = e.target.closest('[data-state]');
      if (!target) { tooltip.style.display = 'none'; return; }
      const status = target.getAttribute('data-status');
      ttState.textContent = target.getAttribute('data-state');
      ttBadge.textContent = statusLabels[status] || status;
      ttBadge.className   = 'map-status-badge status-' + status;
      tooltip.style.display = 'flex';
      let x = e.clientX + 14, y = e.clientY + 14;
      if (x + 240 > window.innerWidth)  x = e.clientX - 240;
      if (y + 62  > window.innerHeight) y = e.clientY - 62;
      tooltip.style.left = x + 'px';
      tooltip.style.top  = y + 'px';
    });
    svg.addEventListener('mouseleave', () => { tooltip.style.display = 'none'; });

    // ---- Click to open panel ----
    svg.addEventListener('click', (e) => {
      const target = e.target.closest('[data-state]');
      if (!target) return;
      tooltip.style.display = 'none';

      const abbr = target.id;
      const data = stateData[abbr];
      if (!data) return;

      // Update active highlight
      if (activeEl) activeEl.classList.remove('map-active');
      activeEl = target;
      target.classList.add('map-active');

      // Populate panel header
      panelName.textContent   = data.name;
      panelBadge.textContent  = statusLabels[data.status];
      panelBadge.className    = 'map-status-badge map-status-badge-lg status-' + data.status;

      // Populate panel body
      if (data.status === 'illegal') {
        panelBody.innerHTML = `
          <div class="panel-illegal-msg">
            <strong>⚠️ Cannabis is not legally available in ${escHtml(data.name)}.</strong>
            <br><br>${escHtml(data.note)}
          </div>`;
      } else {
        const cards = data.dispensaries.length
          ? data.dispensaries.map((d, i) => `
              <div class="panel-disp-card">
                <span class="panel-disp-icon">${DISP_ICONS[i % DISP_ICONS.length]}</span>
                <div class="panel-disp-info">
                  <div class="panel-disp-name">${escHtml(d.name)}</div>
                  <div class="panel-disp-city">📍 ${escHtml(d.city)}</div>
                  <div class="panel-disp-address">${escHtml(d.address)}</div>
                  <div class="panel-disp-phone">${escHtml(d.phone)}</div>
                </div>
              </div>`).join('')
          : '<p class="panel-no-disp">No licensed dispensaries currently listed.</p>';

        panelBody.innerHTML = `
          <div class="panel-law-note"><p>📋 ${escHtml(data.note)}</p></div>
          <div class="panel-section-label">Dispensaries in ${escHtml(data.name)}</div>
          ${cards}
          <a class="panel-learn-more" href="#" onclick="return false;">
            Learn more about ${escHtml(data.name)} cannabis laws →
          </a>`;
      }

      panel.classList.add('open');
      overlay.classList.add('open');
    });

    // ---- Close panel ----
    function closePanel() {
      panel.classList.remove('open');
      overlay.classList.remove('open');
      if (activeEl) { activeEl.classList.remove('map-active'); activeEl = null; }
    }
    btnClose.addEventListener('click', closePanel);
    overlay.addEventListener('click', closePanel);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

    // ---- Helper: escape HTML ----
    function escHtml(s) {
      return String(s)
        .replace(/&/g,'&amp;')
        .replace(/</g,'&lt;')
        .replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;');
    }
  })();
</script>

