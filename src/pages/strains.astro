---
import Layout from '../layouts/Layout.astro';
import { strains } from '../data/strains';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const indicaCount = strains.filter(s => s.type === 'indica').length;
const sativaCount = strains.filter(s => s.type === 'sativa').length;
const hybridCount = strains.filter(s => s.type === 'hybrid').length;
const totalCount = strains.length;
const regionsSet = new Set(strains.map(s => s.region));
const countriesCount = regionsSet.size;

const regionOrder = ["Americas","Europe","Asia","Africa"];
const regionMap: Record<string, typeof strains> = {};
for (const s of strains) {
  if (!regionMap[s.region]) regionMap[s.region] = [];
  regionMap[s.region].push(s);
}
---

<Layout title="Cannabis Strain Guide" description={`Explore ${totalCount.toLocaleString()}+ cannabis strains from around the world — classified by type, origin, effects, and flavor.`}>

  <main class="strains-page">

    <!-- ── Page Header ─────────────────────────────────────────────── -->
    <header class="page-header">
      <div class="header-inner">
        <h1>🌿 Cannabis Strain Guide</h1>
        <p class="subtitle">Explore {totalCount.toLocaleString()}+ strains from around the world, classified by type and origin</p>

        <!-- Stats bar -->
        <div class="stats-bar">
          <span class="stat indica-stat"><span class="dot"></span>{indicaCount.toLocaleString()} Indica</span>
          <span class="stat sativa-stat"><span class="dot"></span>{sativaCount.toLocaleString()} Sativa</span>
          <span class="stat hybrid-stat"><span class="dot"></span>{hybridCount.toLocaleString()} Hybrid</span>
          <span class="stat total-stat"><span class="dot"></span>{totalCount.toLocaleString()} Total Strains</span>
          <span class="stat region-stat"><span class="dot"></span>{countriesCount} Regions</span>
        </div>

        <!-- Search + filter row -->
        <div class="controls">
          <div class="search-wrap">
            <span class="search-icon">🔍</span>
            <input type="search" id="strainSearch" placeholder="Search strains by name…" autocomplete="off" />
          </div>
          <div class="filter-pills" id="filterTabs">
            <button class="filter-btn active" data-filter="all">ALL</button>
            <button class="filter-btn indica" data-filter="indica">INDICA</button>
            <button class="filter-btn sativa" data-filter="sativa">SATIVA</button>
            <button class="filter-btn hybrid" data-filter="hybrid">HYBRID</button>
          </div>
          <div class="sort-wrap">
            <select id="sortSelect">
              <option value="name">Name A–Z</option>
              <option value="thc">THC% High–Low</option>
              <option value="type">By Type</option>
            </select>
          </div>
        </div>
      </div>
    </header>

    <!-- ── Type Explainer Cards ────────────────────────────────────── -->
    <section class="type-cards container">
      <div class="type-card indica-card">
        <div class="type-icon">🟣</div>
        <h3>INDICA</h3>
        <p class="type-tagline">Body high · Relaxing · Sedating</p>
        <ul>
          <li>Shorter, bushy plants with wide leaves</li>
          <li>Higher CBD-to-THC ratio</li>
          <li>Best for evening &amp; nighttime use</li>
          <li>Ideal for pain, insomnia &amp; anxiety</li>
        </ul>
        <div class="type-badge indica-badge">INDICA</div>
      </div>
      <div class="type-card sativa-card">
        <div class="type-icon">🟡</div>
        <h3>SATIVA</h3>
        <p class="type-tagline">Head high · Energizing · Euphoric</p>
        <ul>
          <li>Tall, thin plants with narrow leaves</li>
          <li>Higher THC ratio, less CBD</li>
          <li>Best for daytime &amp; creative use</li>
          <li>Ideal for depression, fatigue &amp; focus</li>
        </ul>
        <div class="type-badge sativa-badge">SATIVA</div>
      </div>
      <div class="type-card hybrid-card">
        <div class="type-icon">🟢</div>
        <h3>HYBRID</h3>
        <p class="type-tagline">Best of both worlds · Versatile</p>
        <ul>
          <li>Bred from indica + sativa parents</li>
          <li>Effects depend on dominant parent</li>
          <li>Flexible — day or night use</li>
          <li>Most modern strains are hybrids</li>
        </ul>
        <div class="type-badge hybrid-badge">HYBRID</div>
      </div>
    </section>

    <!-- ── Results counter ────────────────────────────────────────── -->
    <div class="container results-bar">
      <span id="resultsCount"></span>
    </div>

    <!-- ── Empty State ─────────────────────────────────────────────── -->
    <div class="empty-state hidden" id="emptyState">
      <span class="empty-icon">🔎</span>
      <p>No strains match your search. Try a different name or filter.</p>
    </div>

    <!-- ── Strain Grid (client-rendered) ──────────────────────────── -->
    <section class="container strains-grid" id="strainsGrid"></section>

    <!-- Load More -->
    <div class="container load-more-wrap">
      <button id="loadMoreBtn" class="btn btn-outline hidden">Load More Strains ↓</button>
    </div>

    <!-- ── World Origins Section ───────────────────────────────────── -->
    <section class="container origins-section">
      <h2 class="section-title">🌍 World Origins</h2>
      <p class="section-subtitle">Cannabis has been cultivated across the globe for thousands of years. Showing top strains per region from our database of {totalCount.toLocaleString()}+:</p>
      <div class="origins-grid">
        {regionOrder.map(region => {
          const regionStrains = (regionMap[region] ?? []).slice(0, 12);
          const regionTotal = (regionMap[region] ?? []).length;
          return (
            <div class="origin-card">
              <h3 class="origin-region">{region} <span class="origin-total">({regionTotal.toLocaleString()} strains)</span></h3>
              <div class="origin-strains">
                {regionStrains.map(s => (
                  <div class={`origin-strain origin-strain--${s.type}`}>
                    <span class="origin-emoji">{s.emoji}</span>
                    <div>
                      <span class="origin-name">{s.name}</span>
                      <span class="origin-location">{s.origin}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <div class="landrace-note">
        <span class="landrace-icon">🏴</span>
        <div>
          <strong>About Landraces</strong>
          <p>Landrace strains are cannabis varieties that evolved naturally in their geographic region over centuries without human hybridization. They form the genetic foundation of virtually all modern cannabis. Landraces include Hindu Kush, Afghani, Durban Poison, Thai Stick, Acapulco Gold, and Panama Red.</p>
        </div>
      </div>
    </section>

  </main>

  <!-- Strain data payload (JSON) — read by client script -->
  <script type="application/json" id="strain-data" set:html={JSON.stringify(strains)}></script>

  <script>
    // ── Data ────────────────────────────────────────────────────────
    const STRAINS: any[] = JSON.parse(document.getElementById('strain-data')!.textContent!);
    const BATCH = 60;

    // ── State ───────────────────────────────────────────────────────
    let filtered = STRAINS.slice();
    let rendered = 0;

    // ── DOM refs ────────────────────────────────────────────────────
    const grid        = document.getElementById('strainsGrid')!;
    const searchEl    = document.getElementById('strainSearch') as HTMLInputElement;
    const filterBtns  = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    const sortEl      = document.getElementById('sortSelect') as HTMLSelectElement;
    const emptyState  = document.getElementById('emptyState')!;
    const loadMoreBtn = document.getElementById('loadMoreBtn') as HTMLButtonElement;
    const resultsCount= document.getElementById('resultsCount')!;

    let activeFilter = 'all';
    let searchTerm   = '';

    // ── Card builder ────────────────────────────────────────────────
    function buildCard(s: any, idx: number): HTMLElement {
      const thcRaw    = parseFloat(s.thc.split('-')[1] ?? s.thc);
      const thcBarPct = Math.min(100, (thcRaw / 30) * 100);
      const cbdBarPct = Math.min(100, (s.cbdNum / 2) * 100);
      const shortDesc = s.description.length > 140 ? s.description.slice(0, 140) + '…' : s.description;
      const effectTags= s.effects.map((e:string) => `<span class="tag tag-effect">${e}</span>`).join('');
      const flavorTags= s.flavors.map((f:string) => `<span class="tag tag-flavor">${f}</span>`).join('');
      const medTags   = s.medical.map((m:string) => `<span class="tag tag-medical">${m}</span>`).join('');

      const el = document.createElement('article');
      el.className = `strain-card strain-card--${s.type}`;
      el.dataset.type = s.type;
      el.dataset.name = s.name.toLowerCase();
      el.dataset.thc  = String(s.thcNum);

      el.innerHTML = `
        <div class="card-header-bar card-header-bar--${s.type}">
          <span class="card-emoji">${s.emoji}</span>
          <div class="card-title-group">
            <h2 class="card-name">${s.name}</h2>
            <span class="type-pill type-pill--${s.type}">${s.type.toUpperCase()}</span>
          </div>
        </div>
        <div class="card-body">
          <p class="card-origin">📍 ${s.origin}</p>
          <div class="potency-bars">
            <div class="potency-row">
              <span class="potency-label">THC</span>
              <div class="bar-track"><div class="bar-fill bar-thc" style="width:${thcBarPct}%"></div></div>
              <span class="potency-value">${s.thc}</span>
            </div>
            <div class="potency-row">
              <span class="potency-label">CBD</span>
              <div class="bar-track"><div class="bar-fill bar-cbd" style="width:${Math.max(cbdBarPct,3)}%"></div></div>
              <span class="potency-value">${s.cbd}</span>
            </div>
          </div>
          <p class="card-desc">${shortDesc}</p>
          <div class="tag-group">
            <span class="tag-label">Effects</span>
            <div class="tags">${effectTags}</div>
          </div>
          <div class="tag-group">
            <span class="tag-label">Flavors</span>
            <div class="tags">${flavorTags}</div>
          </div>
          <button class="expand-btn" aria-expanded="false">Show Details <span class="expand-arrow">▾</span></button>
          <div class="expand-panel hidden">
            <div class="expand-grid">
              <div class="expand-item"><span class="expand-item-label">🌿 Parentage</span><span class="expand-item-value">${s.parentage}</span></div>
              <div class="expand-item"><span class="expand-item-label">⏱ Grow Time</span><span class="expand-item-value">${s.growTime}</span></div>
              <div class="expand-item"><span class="expand-item-label">📦 Yield</span><span class="expand-item-value">${s.yield}</span></div>
              <div class="expand-item"><span class="expand-item-label">🌍 Region</span><span class="expand-item-value">${s.region}</span></div>
            </div>
            <div class="tag-group" style="margin-top:0.75rem">
              <span class="tag-label">Medical Uses</span>
              <div class="tags">${medTags}</div>
            </div>
            <p class="card-desc full-desc">${s.description}</p>
          </div>
        </div>`;

      // expand toggle
      el.querySelector('.expand-btn')!.addEventListener('click', function(this: HTMLButtonElement) {
        const panel  = this.nextElementSibling as HTMLElement;
        const isOpen = !panel.classList.contains('hidden');
        panel.classList.toggle('hidden', isOpen);
        this.setAttribute('aria-expanded', String(!isOpen));
        this.innerHTML = isOpen
          ? `Show Details <span class="expand-arrow">▾</span>`
          : `Hide Details <span class="expand-arrow" style="transform:rotate(180deg);display:inline-block">▾</span>`;
      });

      return el;
    }

    // ── Render batch ─────────────────────────────────────────────────
    function renderBatch() {
      const frag = document.createDocumentFragment();
      const end  = Math.min(rendered + BATCH, filtered.length);
      for (let i = rendered; i < end; i++) {
        frag.appendChild(buildCard(filtered[i], i));
      }
      grid.appendChild(frag);
      rendered = end;
      const hasMore = rendered < filtered.length;
      loadMoreBtn.classList.toggle('hidden', !hasMore);
      loadMoreBtn.textContent = `Load More Strains (${(filtered.length - rendered).toLocaleString()} remaining) ↓`;
    }

    // ── Apply filters + search ────────────────────────────────────────
    function applyFilters() {
      const term = searchTerm.toLowerCase().trim();
      filtered = STRAINS.filter(s => {
        const matchType   = activeFilter === 'all' || s.type === activeFilter;
        const matchSearch = !term || s.name.toLowerCase().includes(term);
        return matchType && matchSearch;
      });

      // sort
      const order = sortEl.value;
      if (order === 'name')  filtered.sort((a,b) => a.name.localeCompare(b.name));
      if (order === 'thc')   filtered.sort((a,b) => b.thcNum - a.thcNum);
      if (order === 'type') {
        const rank = ['indica','sativa','hybrid'];
        filtered.sort((a,b) => rank.indexOf(a.type) - rank.indexOf(b.type));
      }

      grid.innerHTML = '';
      rendered = 0;
      emptyState.classList.toggle('hidden', filtered.length > 0);
      resultsCount.textContent = filtered.length > 0 ? `Showing ${Math.min(BATCH, filtered.length).toLocaleString()} of ${filtered.length.toLocaleString()} strains` : '';
      if (filtered.length > 0) renderBatch();
    }

    // ── Event listeners ───────────────────────────────────────────────
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeFilter = btn.dataset.filter ?? 'all';
        applyFilters();
      });
    });

    searchEl.addEventListener('input', () => {
      searchTerm = searchEl.value;
      applyFilters();
    });

    sortEl.addEventListener('change', () => applyFilters());

    loadMoreBtn.addEventListener('click', () => {
      renderBatch();
      resultsCount.textContent = `Showing ${Math.min(rendered, filtered.length).toLocaleString()} of ${filtered.length.toLocaleString()} strains`;
    });

    // ── Initial render ────────────────────────────────────────────────
    applyFilters();
  </script>

</Layout>

<style is:global>
  /* ── Base ─────────────────────────────────────────────────────────── */
  .strains-page { padding-bottom: 4rem; }
  .container { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem; }
  .hidden { display: none !important; }

  /* ── Page Header ──────────────────────────────────────────────────── */
  .page-header {
    background: linear-gradient(160deg, #e6f2ec 0%, #eaf2ed 60%, #f4f7f5 100%);
    border-bottom: 1px solid #c8ddd1;
    padding: 3rem 1.5rem 2rem;
    text-align: center;
  }
  .header-inner { max-width: 900px; margin: 0 auto; }
  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: #15803d;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
  .subtitle { color: #4b6358; font-size: 1.1rem; margin-bottom: 1.75rem; }

  /* Stats bar */
  .stats-bar {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 0.5rem 1.5rem; margin-bottom: 1.75rem;
  }
  .stat { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; font-weight: 600; color: #4b6358; }
  .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .indica-stat .dot  { background: #a78bfa; }
  .sativa-stat .dot  { background: #fbbf24; }
  .hybrid-stat .dot  { background: #2dd4bf; }
  .total-stat .dot   { background: #4ade80; }
  .region-stat .dot  { background: #60a5fa; }

  /* Controls */
  .controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem; }
  .search-wrap { position: relative; flex: 1; min-width: 220px; max-width: 360px; }
  .search-icon { position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); font-size: 0.9rem; pointer-events: none; }
  #strainSearch {
    width: 100%; background: #ffffff; border: 1px solid #c8ddd1; border-radius: 8px;
    padding: 0.6rem 0.75rem 0.6rem 2.25rem; color: #1a2e1f; font-size: 0.95rem; outline: none; transition: border-color 0.2s;
  }
  #strainSearch:focus { border-color: #16a34a; }
  #strainSearch::placeholder { color: #9ab8a8; }

  .filter-pills { display: flex; gap: 0.4rem; }
  .filter-btn {
    background: #ffffff; border: 1px solid #c8ddd1; border-radius: 20px; color: #4b6358;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; padding: 0.45rem 1rem; cursor: pointer; transition: all 0.2s;
  }
  .filter-btn:hover        { border-color: #16a34a; color: #16a34a; }
  .filter-btn.active       { background: #16a34a; color: #ffffff; border-color: #16a34a; }
  .filter-btn.indica.active{ background: #7c3aed; border-color: #7c3aed; color: #fff; }
  .filter-btn.sativa.active{ background: #b45309; border-color: #b45309; color: #fff; }
  .filter-btn.hybrid.active{ background: #0d9488; border-color: #0d9488; color: #fff; }

  .sort-wrap select {
    background: #ffffff; border: 1px solid #c8ddd1; border-radius: 8px; color: #4b6358;
    font-size: 0.9rem; padding: 0.55rem 0.75rem; cursor: pointer; outline: none;
  }
  .sort-wrap select:focus { border-color: #16a34a; }

  /* Results bar */
  .results-bar { padding: 0.75rem 1.5rem; color: #4b6358; font-size: 0.85rem; }

  /* ── Type Explainer Cards ─────────────────────────────────────────── */
  .type-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; padding-top: 2.5rem; padding-bottom: 2rem; }
  .type-card {
    background: #ffffff; border-radius: 16px; padding: 1.75rem; position: relative; overflow: hidden;
    border: 1px solid #c8ddd1; transition: transform 0.2s, box-shadow 0.2s;
  }
  .type-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.1); }
  .indica-card { border-left: 4px solid #a78bfa; }
  .sativa-card { border-left: 4px solid #fbbf24; }
  .hybrid-card { border-left: 4px solid #2dd4bf; }
  .type-icon { font-size: 2rem; margin-bottom: 0.5rem; }
  .type-card h3 { font-size: 1.1rem; font-weight: 800; letter-spacing: 0.08em; margin-bottom: 0.25rem; }
  .indica-card h3 { color: #7c3aed; }
  .sativa-card h3 { color: #b45309; }
  .hybrid-card h3 { color: #0d9488; }
  .type-tagline { color: #4b6358; font-size: 0.85rem; font-style: italic; margin-bottom: 1rem; }
  .type-card ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .type-card ul li { color: #4b6358; font-size: 0.875rem; padding-left: 1.1rem; position: relative; }
  .type-card ul li::before { content: '›'; position: absolute; left: 0; color: #16a34a; }
  .type-badge { position: absolute; bottom: 1.25rem; right: 1.25rem; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; padding: 0.2rem 0.6rem; border-radius: 20px; opacity: 0.7; }
  .indica-badge { background: #7c3aed22; color: #7c3aed; border: 1px solid #7c3aed44; }
  .sativa-badge { background: #b4530922; color: #b45309; border: 1px solid #b4530944; }
  .hybrid-badge { background: #0d948822; color: #0d9488; border: 1px solid #0d948844; }

  /* ── Empty state ─────────────────────────────────────────────────── */
  .empty-state { text-align: center; padding: 4rem 1rem; color: #4b6358; }
  .empty-icon { font-size: 3rem; display: block; margin-bottom: 1rem; }

  /* ── Strains Grid ────────────────────────────────────────────────── */
  .strains-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; padding-top: 0.5rem; padding-bottom: 1.5rem; }
  @media (max-width: 1100px) { .strains-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 680px)  { .strains-grid { grid-template-columns: 1fr; } }

  /* Load more */
  .load-more-wrap { text-align: center; padding-bottom: 2.5rem; }
  #loadMoreBtn { padding: 0.75rem 2rem; font-size: 0.95rem; }

  /* ── Strain Card ─────────────────────────────────────────────────── */
  .strain-card {
    background: #ffffff; border-radius: 14px; border: 1px solid #c8ddd1;
    overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column;
  }
  .strain-card:hover { transform: translateY(-5px); box-shadow: 0 16px 48px rgba(0,0,0,0.1); }
  .strain-card--indica { border-left: 4px solid #a78bfa; }
  .strain-card--sativa { border-left: 4px solid #fbbf24; }
  .strain-card--hybrid { border-left: 4px solid #2dd4bf; }

  .card-header-bar { display: flex; align-items: center; gap: 0.9rem; padding: 1rem 1.1rem 0.8rem; border-bottom: 1px solid #c8ddd1; }
  .card-header-bar--indica { background: linear-gradient(90deg, #a78bfa18 0%, transparent 100%); }
  .card-header-bar--sativa { background: linear-gradient(90deg, #fbbf2418 0%, transparent 100%); }
  .card-header-bar--hybrid { background: linear-gradient(90deg, #2dd4bf18 0%, transparent 100%); }
  .card-emoji { font-size: 2rem; line-height: 1; flex-shrink: 0; }
  .card-title-group { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .card-name { font-size: 1.05rem; font-weight: 700; color: #1a2e1f; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .type-pill { display: inline-block; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.08em; padding: 0.15rem 0.55rem; border-radius: 20px; width: fit-content; }
  .type-pill--indica { background: #7c3aed22; color: #7c3aed; border: 1px solid #7c3aed55; }
  .type-pill--sativa { background: #b4530922; color: #b45309; border: 1px solid #b4530955; }
  .type-pill--hybrid { background: #0d948822; color: #0d9488; border: 1px solid #0d948855; }

  .card-body { padding: 1rem 1.1rem; flex: 1; display: flex; flex-direction: column; gap: 0.75rem; }
  .card-origin { font-size: 0.8rem; color: #4b6358; margin: 0; }

  .potency-bars { display: flex; flex-direction: column; gap: 0.4rem; }
  .potency-row { display: grid; grid-template-columns: 32px 1fr 60px; align-items: center; gap: 0.5rem; }
  .potency-label { font-size: 0.7rem; font-weight: 700; color: #4b6358; letter-spacing: 0.04em; }
  .bar-track { background: #daeae0; border-radius: 99px; height: 6px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 99px; transition: width 0.6s ease; }
  .bar-thc { background: linear-gradient(90deg, #4ade80, #86efac); }
  .bar-cbd { background: linear-gradient(90deg, #60a5fa, #93c5fd); }
  .potency-value { font-size: 0.72rem; color: #4b6358; text-align: right; white-space: nowrap; }

  .card-desc { font-size: 0.83rem; color: #4b6358; line-height: 1.55; margin: 0; }
  .full-desc { color: #4b6358; margin-top: 0.5rem; }

  .tag-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .tag-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; color: #4b6358; text-transform: uppercase; }
